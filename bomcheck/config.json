  "non_drawn_patterns": "electrode|filler|welding|insulation|mineral wool|rockwool|cladding|primer|paint|consumable",
  "implied_rules": [
    {
      "label": "Welding consumables",
      "when": "WELD",
      "expect": "electrode|filler|welding"
    },
    {
      "label": "Insulation",
      "when": "INSULAT",
      "expect": "insulat|mineral wool|rockwool"
    },
    {
      "label": "Cladding",
      "when": "CLAD",
      "expect": "clad"
    },
    {
      "label": "Paint / primer",
      "when": "PAINT|PRIMER",
      "expect": "paint|primer"
    }
  ],
  "multiplier": {
    "note_regex": "PER\\s+BANK",
    "count_regex": "(\\d+)\\s+BANKS",
    "applies_to": "economiser tube"
  },
